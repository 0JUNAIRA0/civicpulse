# PostgreSQL connection string (Neon, Supabase, RDS, or local). Add ?sslmode=require for hosted DBs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicpulse
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
# Shared secret for the automated maintenance reminder endpoint (/api/cron/reminders)
CRON_SECRET=replace-with-another-random-string
